default_platform(:ios)

PROJECT = "Danogotchi.xcodeproj"
SCHEME  = "Danogotchi"
# TCA 매크로·SwiftLint 플러그인 CI 검증 생략
SKIP_VALIDATION = "-skipMacroValidation -skipPackagePluginValidation"

platform :ios do
  # ---------------------------------------------------------------
  # CI: PR / main push 때 실행 (서명 불필요, 시뮬레이터에서 테스트)
  # ---------------------------------------------------------------
  desc "빌드 + 단위 테스트"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      only_testing: ["DanogotchiTests"],   # UI 테스트 제외
      parallel_testing: false,             # CI 러너에서 시뮬레이터 클론 멈춤 방지
      # 멈춘 테스트는 1분 뒤 실패 처리
      xcargs: "#{SKIP_VALIDATION} -test-timeouts-enabled YES -default-test-execution-time-allowance 60",
      clean: true
      # device: "iPhone 17"  # 특정 시뮬레이터를 쓰고 싶을 때만 지정
    )
  end

  # ---------------------------------------------------------------
  # CD: v*.*.* 태그 push 때 실행 → TestFlight 업로드
  # ---------------------------------------------------------------
  desc "태그에서 버전을 읽어 TestFlight에 배포"
  lane :release do
    # CI 환경에서 임시 키체인 생성 (로컬에서는 아무것도 하지 않음)
    setup_ci

    # App Store Connect API Key 인증 (이후 액션들이 자동으로 사용)
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 1) 태그에서 버전 파싱: v2.3.0+1 → 2.3.0
    tag = ENV["GITHUB_REF_NAME"].to_s
    parsed = tag.match(/\Av(\d+\.\d+\.\d+)(\+\d+)?\z/)
    UI.user_error!("태그 형식이 올바르지 않습니다: '#{tag}' (예: v2.3.0+1)") unless parsed
    version = parsed[1]

    # 2) 빌드 번호: 같은 버전의 TestFlight 최신 빌드 + 1
    build_number = latest_testflight_build_number(
      version: version,
      initial_build_number: 0
    ).to_i + 1

    UI.important("배포 버전: #{version} (#{build_number})")

    # 3) 인증서·프로파일 내려받기 (CI에서는 읽기 전용)
    match(type: "appstore", readonly: true)

    # 4) 빌드 — 프로젝트 파일은 건드리지 않고, 이번 빌드에만 값을 덮어씀
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "#{SKIP_VALIDATION} MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}"
    )

    # 5) 이전 태그 이후 커밋을 TestFlight "What to Test"에 넣기
    prev_tag = sh("git describe --tags --abbrev=0 HEAD^ 2>/dev/null || true").strip
    changelog =
      if prev_tag.empty?
        "첫 배포"
      else
        changelog_from_git_commits(
          between: [prev_tag, "HEAD"],
          merge_commit_filtering: "exclude_merges",
          pretty: "- %s"
        )
      end

    # 6) 업로드 (내부 테스터에게만 자동 배포, 외부 테스터는 수동)
    upload_to_testflight(
      changelog: changelog
      # skip_waiting_for_build_processing: true  # macOS 사용 시간을 아끼려면 켜기 (단, changelog는 적용되지 않음)
    )
  end
end
